# Copy to local.mk (git-ignored). `make install` reads it, so TRUSTED_DIRS and
# DEV_ROOT are baked into the binary without repeating them on the command line.
# A value given on the command line (make install DEV_ROOT=...) still wins.
TRUSTED_DIRS = ~/bin
DEV_ROOT = ~/src
# `make cert` writes SIGN_IDENTITY (the SHA-1 of your signing certificate) here
# for you. Do not copy a value from someone else: items trust YOUR certificate.
# SIGN_IDENTITY = 0123456789ABCDEF0123456789ABCDEF01234567
